import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

formatter(ignore: [ "codeblock_parser.mbt" ])

rule(
  name: "moonlex",
  command: "moon runwasm moonbitlang/ulex@0.3.29 $input -o $output",
)

dev_build(
  rule: "moonlex",
  input: "codeblock_parser.mbtx",
  output: "codeblock_parser.mbt",
)
