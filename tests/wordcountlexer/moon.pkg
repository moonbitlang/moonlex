import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

formatter(ignore: [ "wordcountlexer.mbt" ])

rule(
  name: "moonlex",
  command: "moon run --target wasm $mod_dir/.. -- $input -o $output",
)

dev_build(
  rule: "moonlex",
  input: "wordcountlexer.mbtx",
  output: "wordcountlexer.mbt",
)
