import {
  "moonbitlang/ulex_tests/bytes_unicode_test/lexbuf",
  "moonbitlang/core/int",
}

warnings = "-1-13"

rule(
  name: "moonlex",
  command: "moon runwasm $mod_dir/.. -- --code-unit 1 --default-encoding utf8 $input -o $output",
)

dev_build(rule: "moonlex", input: "bytes.mbtx", output: "bytes.mbt")
