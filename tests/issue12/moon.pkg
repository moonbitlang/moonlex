import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

warnings = "-1"

formatter(ignore: [ "issue12.mbt" ])

rule(
  name: "moonlex",
  command: "moon run --target wasm $mod_dir/.. -- $input -o $output",
)

dev_build(rule: "moonlex", input: "issue12.mbtx", output: "issue12.mbt")
