import {
  "moonbitlang/ulex_tests/bytes_test/lexbuf",
  "moonbitlang/core/int",
}

warnings = "-1"

formatter(ignore: [ "bytes.mbt" ])

rule(
  name: "moonlex",
  command: "moon -C $mod_dir/.. run --target wasm . -- $mod_dir/$input -o $mod_dir/$output",
)

dev_build(rule: "moonlex", input: "bytes.mbtx", output: "bytes.mbt")
