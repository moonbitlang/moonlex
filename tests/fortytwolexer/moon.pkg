import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

formatter(ignore: [ "fortytwolexer.mbt" ])

rule(
  name: "moonlex",
  command: "moon -C $mod_dir/.. run --target wasm . -- $mod_dir/$input -o $mod_dir/$output",
)

dev_build(
  rule: "moonlex",
  input: "fortytwolexer.mbtx",
  output: "fortytwolexer.mbt",
)
