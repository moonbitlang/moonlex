import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

warnings = "-1"

formatter(ignore: [ "a_star_capture.mbt" ])

rule(
  name: "moonlex",
  command: "moon -C $mod_dir/.. run --target wasm . -- $mod_dir/$input -o $mod_dir/$output",
)

dev_build(
  rule: "moonlex",
  input: "a_star_capture.mbtx",
  output: "a_star_capture.mbt",
)
