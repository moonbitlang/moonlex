import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

warnings = "-1-13"

formatter(ignore: ["named_regexes.mbt"])

rule(name: "moonlex", command: "moon runwasm $mod_dir/.. $input -o $output")

dev_build(
  rule: "moonlex",
  input: "named_regexes.mbtx",
  output: "named_regexes.mbt",
)
