import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

warnings = "-1-13"

formatter(ignore: [ "unicode.mbt" ])

rule(
  name: "moonlex",
  command: "moon -C $mod_dir/.. run --target wasm . -- $mod_dir/$input -o $mod_dir/$output",
)

dev_build(rule: "moonlex", input: "unicode.mbtx", output: "unicode.mbt")
