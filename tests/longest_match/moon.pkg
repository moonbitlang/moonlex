import {
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/core/int",
}

warnings = "-1-13"

formatter(ignore: [ "longest_match.mbt" ])

rule(
  name: "moonlex",
  command: "moon -C $mod_dir/.. run --target wasm . -- $mod_dir/$input -o $mod_dir/$output",
)

dev_build(
  rule: "moonlex",
  input: "longest_match.mbtx",
  output: "longest_match.mbt",
)
