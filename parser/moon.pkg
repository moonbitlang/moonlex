import {
  "moonbitlang/ulex/type",
  "moonbitlang/ulex/util/char_set",
  "moonbitlang/ulex-runtime/lexbuf",
  "moonbitlang/ulex/regex",
  "moonbitlang/core/immut/sorted_map" @immut/sorted_map,
  "moonbitlang/core/int",
  "moonbitlang/core/list",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/core/test",
} for "test"

import {
  "moonbitlang/core/test",
} for "wbtest"

formatter(ignore: ["lexer.mbt", "parser.mbt"])

rule(
  name: "moonlex",
  command: "moon runwasm moonbitlang/ulex@0.3.29 $input -o $output",
)

dev_build(rule: "moonlex", input: "lexer.mbtx", output: "lexer.mbt")

rule(
  name: "moonyacc",
  command: "moon runwasm moonbitlang/yacc@0.7.16 --input-mode pull $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")

rule(
  name: "embed",
  command: "moon runwasm moonbit-community/embed $input -o $output",
)

dev_build(rule: "embed", input: "lexer.mbtx", output: "for_parser_wbtest.mbt")
